{
  "name": "tavern-vault",
  "version": "1.0.0",
  "description": "Self-hosted SillyTavern local archival vault for character cards (JSON/PNG), presets, themes, worldbooks, and regex scripts.",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "service:install": "powershell -ExecutionPolicy Bypass -File scripts/nssm-service.ps1 install",
    "service:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/nssm-service.ps1 uninstall",
    "service:start": "powershell -ExecutionPolicy Bypass -File scripts/nssm-service.ps1 start",
    "service:stop": "powershell -ExecutionPolicy Bypass -File scripts/nssm-service.ps1 stop",
    "service:restart": "powershell -ExecutionPolicy Bypass -File scripts/nssm-service.ps1 restart",
    "service:status": "powershell -ExecutionPolicy Bypass -File scripts/nssm-service.ps1 status",
    "service:logs": "powershell -ExecutionPolicy Bypass -File scripts/nssm-service.ps1 logs"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
